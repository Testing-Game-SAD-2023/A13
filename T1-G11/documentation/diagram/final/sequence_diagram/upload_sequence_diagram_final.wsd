@startuml Upload_Sequence_Diagram_Final

!define CONTROLLER_COLOR #E1F5FE
!define SERVICE_COLOR #FFF3E0
!define REPOSITORY_COLOR #F3E5F5

skinparam sequence {
    ParticipantBackgroundColor CONTROLLER_COLOR
    ActorBackgroundColor #C5E1A5
    LifeLineBackgroundColor white
    LifeLineBorderColor #424242
    ArrowColor #424242
}

actor "Admin/Teacher" as Admin
participant "OpponentController" as Controller <<Controller>> CONTROLLER_COLOR
participant "OpponentService" as OpponentSvc <<Service>> SERVICE_COLOR
participant "ClassUTUploadService" as ClassUploadSvc <<Service>> SERVICE_COLOR
participant "UploadOpponentService" as OpponentUploadSvc <<Service>> SERVICE_COLOR
participant "FileStorageService" as FileSvc <<Service>> SERVICE_COLOR
participant "JavaSourceFileService" as JavaSvc <<Service>> SERVICE_COLOR
participant "CoverageService" as CoverageSvc <<Service>> SERVICE_COLOR
participant "OpponentTransformationService" as TransformSvc <<Service>> SERVICE_COLOR
participant "OpponentPersistenceService" as PersistSvc <<Service>> SERVICE_COLOR
database "ClassRepository" as ClassRepo <<Repository>> REPOSITORY_COLOR
database "OpponentRepository" as OpponentRepo <<Repository>> REPOSITORY_COLOR

Admin -> Controller: POST /opponents\n(classUTFile, classUTDetails, robotTestsZip)
activate Controller

Controller -> OpponentSvc: uploadClassAndOpponents(classUTFile, classUTDetails, robotTestsZip)
activate OpponentSvc

' Validate and Parse ClassUT Details
OpponentSvc -> OpponentSvc: validate file presence
note right
  Check:
  - classUTFile not null/empty
  - robotTestsZip not null/empty
  Throws FileUploadException if invalid
end note

OpponentSvc -> OpponentSvc: parse JSON to ClassUT
note right
  ClassUTDetailsDTO.parseFromJson(classUTDetails)
  Throws ClassValidationException if JSON invalid
end note

OpponentSvc -> OpponentSvc: JavaMetadataExtractor.getClassNameFromJavaSourceFile()
note right
  Extract class name from .java file
  Verify:
  - Class declaration exists
  - Class name matches form input
  Throws ClassValidationException if mismatch
end note

OpponentSvc -> OpponentSvc: FormValidation.validateClassUT(classe)
note right
  Validates ClassUT object:
  - Class name length (1-30 chars)
  - Description length (≤150 chars)
  - Category count (≤3) and length (≤30 each)
  - Difficulty: Beginner/Intermediate/Advanced
  Returns false if invalid → ClassValidationException
end note

' Save ClassUT File
OpponentSvc -> ClassUploadSvc: saveClassUTFile(fileName, name, file)
activate ClassUploadSvc
ClassUploadSvc -> FileSvc: saveFileInFileSystem(fileName, path, file)
activate FileSvc
FileSvc --> ClassUploadSvc: file saved
deactivate FileSvc
ClassUploadSvc --> OpponentSvc: saved
deactivate ClassUploadSvc

' Process Robot Tests ZIP (synchronous processing)
OpponentSvc -> OpponentUploadSvc: saveOpponentsFromZip(fileName, name, file, zip)
activate OpponentUploadSvc

' Extract ZIP
OpponentUploadSvc -> FileSvc: saveFileInFileSystem("robot.zip", tmpFolder, zip)
activate FileSvc
FileSvc --> OpponentUploadSvc: saved
deactivate FileSvc

OpponentUploadSvc -> FileSvc: extractZipIn(tmpFolder)
activate FileSvc
FileSvc --> OpponentUploadSvc: extracted
deactivate FileSvc

' Save unmodified source code
OpponentUploadSvc -> FileSvc: saveFileInFileSystem(fileName, unmodifiedPath, file)
activate FileSvc
FileSvc --> OpponentUploadSvc: saved
deactivate FileSvc

' Process each robot type (Evosuite/Randoop)
loop for each Robot Folder
    OpponentUploadSvc -> OpponentUploadSvc: processRobotFolders()
    
    loop for each Level Folder
        OpponentUploadSvc -> OpponentUploadSvc: processLevelFolder()
        
        ' Save test files
        OpponentUploadSvc -> JavaSvc: saveTestFilesInVolume(fromPath, toPath, className, robotType)
        activate JavaSvc
        JavaSvc --> OpponentUploadSvc: packageNames[][]
        deactivate JavaSvc
        
        ' Save source files
        OpponentUploadSvc -> JavaSvc: saveSrcFileInVolume(file, srcPath, packageName, fileName)
        activate JavaSvc
        JavaSvc -> FileSvc: saveFileInFileSystem(...)
        activate FileSvc
        FileSvc --> JavaSvc: saved
        deactivate FileSvc
        JavaSvc --> OpponentUploadSvc: saved
        deactivate JavaSvc
        
        ' Save coverage files
        OpponentUploadSvc -> JavaSvc: saveCoverageFilesInVolume(fromPath, toPath)
        activate JavaSvc
        JavaSvc --> OpponentUploadSvc: coverageFound[]
        deactivate JavaSvc
        
        ' Generate missing coverage if needed
        alt Evosuite Coverage Missing
            OpponentUploadSvc -> CoverageSvc: generateMissingEvoSuiteCoverage(classUTName, srcPackage, zip)
            activate CoverageSvc
            CoverageSvc --> OpponentUploadSvc: EvosuiteCoverageDTO
            deactivate CoverageSvc
            
            OpponentUploadSvc -> FileSvc: writeStringToFile(statistics.csv, file)
            activate FileSvc
            FileSvc --> OpponentUploadSvc: written
            deactivate FileSvc
        end
        
        alt Jacoco Coverage Missing
            OpponentUploadSvc -> CoverageSvc: generateMissingJacocoCoverage(classUTName, zip)
            activate CoverageSvc
            CoverageSvc --> OpponentUploadSvc: JacocoCoverageDTO
            deactivate CoverageSvc
            
            OpponentUploadSvc -> FileSvc: writeStringToFile(coveragetot.xml, file)
            activate FileSvc
            FileSvc --> OpponentUploadSvc: written
            deactivate FileSvc
        end
        
        ' Transform and persist opponent
        OpponentUploadSvc -> TransformSvc: createAndPersistOpponent(classUT, robotType, level, paths)
        activate TransformSvc
        
        TransformSvc -> TransformSvc: readCoverageFiles()
        TransformSvc -> TransformSvc: buildScores()
        TransformSvc -> TransformSvc: createOpponent()
        
        TransformSvc -> PersistSvc: saveOpponentAndNotify(opponent)
        activate PersistSvc
        
        PersistSvc -> OpponentRepo: saveOpponent(opponent)
        activate OpponentRepo
        OpponentRepo --> PersistSvc: saved
        deactivate OpponentRepo
        
        PersistSvc -> PersistSvc: apiGatewayClient.callAddNewOpponent()
        note right: Notify external API Gateway\nfor each game mode
        
        PersistSvc --> TransformSvc: saved
        deactivate PersistSvc
        
        TransformSvc --> OpponentUploadSvc: opponent persisted
        deactivate TransformSvc
    end
end

' Cleanup temporary files
OpponentUploadSvc -> FileSvc: deleteDirectoryRecursively(tmpFolder)
activate FileSvc
FileSvc --> OpponentUploadSvc: deleted
deactivate FileSvc

OpponentUploadSvc --> OpponentSvc: all opponents processed
deactivate OpponentUploadSvc

' Persist ClassUT Metadata (after opponent processing)
OpponentSvc -> ClassUploadSvc: persistClassUTMetadata(classe, fileName)
activate ClassUploadSvc
ClassUploadSvc -> ClassRepo: save(classe)
activate ClassRepo
ClassRepo --> ClassUploadSvc: ClassUT persisted
deactivate ClassRepo
ClassUploadSvc --> OpponentSvc: metadata persisted
deactivate ClassUploadSvc

OpponentSvc --> Controller: FileUploadResponse
deactivate OpponentSvc

Controller --> Admin: 200 OK (FileUploadResponse)
deactivate Controller

== Error Handling and Rollback ==

group Exception Occurs During Upload
    note over OpponentSvc
        On any exception during upload process:
        - FileUploadException
        - ClassValidationException
        - RobotProcessingException
        - IOException
    end note
    
    OpponentSvc -> OpponentSvc: performRollback(classUTName)
    activate OpponentSvc
    
    OpponentSvc -> ClassUploadSvc: rollbackClassUTMetadata(classUTName)
    activate ClassUploadSvc
    ClassUploadSvc -> ClassRepo: deleteByName(classUTName)
    activate ClassRepo
    ClassRepo --> ClassUploadSvc: deleted
    deactivate ClassRepo
    deactivate ClassUploadSvc
    
    OpponentSvc -> OpponentRepo: deleteByClassUT(classUTName)
    activate OpponentRepo
    OpponentRepo --> OpponentSvc: deleted
    deactivate OpponentRepo
    
    OpponentSvc -> OpponentSvc: apiGatewayClient.callDeleteAllClassUTOpponents()
    note right: Notify external services to delete opponents
    
    OpponentSvc -> OpponentUploadSvc: rollbackOpponentFiles(classUTName)
    activate OpponentUploadSvc
    OpponentUploadSvc -> FileSvc: deleteDirectoryRecursively(opponentPath)
    activate FileSvc
    FileSvc --> OpponentUploadSvc: deleted
    deactivate FileSvc
    deactivate OpponentUploadSvc
    
    OpponentSvc -> ClassUploadSvc: rollbackClassUTFile(classUTName)
    activate ClassUploadSvc
    ClassUploadSvc -> FileSvc: deleteDirectoryRecursively(classUTPath)
    activate FileSvc
    FileSvc --> ClassUploadSvc: deleted
    deactivate FileSvc
    deactivate ClassUploadSvc
    
    deactivate OpponentSvc
    
    OpponentSvc --> Controller: throw exception
    Controller --> Admin: Error Response (GlobalExceptionHandler)
    note right
        Returns localized error message
        with appropriate HTTP status
    end note
end

@enduml
